{
  "name": "@voting/backend",
  "version": "2.0.0",
  "private": true,
  "description": "Express + MongoDB API for the blockchain voting system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seedParties.js",
    "reset-votes": "node scripts/reset-votes.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "keywords": [
    "voting",
    "blockchain",
    "ethereum",
    "mern"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.16.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "js,json",
    "ignore": [
      "tests/*"
    ]
  }
}
