# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (default: any)
# CORS_ORIGIN=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/voting-system

# ── Secrets (required in production) ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Pepper for the anonymous on-chain voter key. Never change it mid-election.
VOTER_KEY_SECRET=change-me-too

# ── Blockchain ────────────────────────────────────────────────────────────
RPC_URL=http://127.0.0.1:8545
# Relayer wallet that owns the Voting contract. Defaults to Hardhat account #0
# for local RPC URLs; required for any other network.
# RELAYER_PRIVATE_KEY=0x...
# Normally read from backend/blockchain/deployment.json (written by `npm run deploy`).
# CONTRACT_ADDRESS=0x...
# CONTRACT_DEPLOY_BLOCK=0
# CHAIN_ID=31337

# ── OTP / SMS ─────────────────────────────────────────────────────────────
# Renflair SMS gateway key. Leave empty in development: OTPs are then printed
# to the server log and shown in the UI.
RENFLAIR_API_KEY=
OTP_TTL_MINUTES=10

# ── Admin ─────────────────────────────────────────────────────────────────
# Mobile numbers allowed to sign in to the admin dashboard
ADMIN_PHONES=9694671392
